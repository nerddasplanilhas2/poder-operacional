# Copie este arquivo para ".env.local" (rodando no seu PC) ou cadastre estas
# variaveis no Vercel (Project Settings > Environment Variables).

# --- Banco de dados (Upstash Redis) ---
# No Vercel: Storage > escolha "Upstash for Redis" > Connect.
# Isso injeta estas variaveis AUTOMATICAMENTE. So preencha manualmente se
# rodar no seu PC (pegue os valores no painel do Upstash).
UPSTASH_REDIS_REST_URL=https://SEU-BANCO.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token

# --- Login do painel (voce define) ---
COMANDANTE_EMAIL=tonhochucre@gmail.com
COMANDANTE_SENHA=troque-esta-senha
DIRETOR_EMAIL=segundo_email@gmail.com
DIRETOR_SENHA=troque-esta-senha

# Segredo para assinar a sessao (gere um valor aleatorio longo).
# Ex.: rode no terminal:  openssl rand -base64 32
AUTH_SECRET=cole-aqui-um-valor-aleatorio-longo
